// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  password     String        @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  name         String?       @db.VarChar(150)
  companyUsers CompanyUser[]
  appointments Appointment[]

  @@map("users")
}

enum CompanyRole {
  OWNER
  MANAGER
  EMPLOYEE
}

model Company {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(150)
  timeZone String? @db.VarChar(64)

  users    CompanyUser[]
  services Service[]

  @@map("companies")
}

model CompanyUser {
  id        Int         @id @default(autoincrement())
  userId    Int
  companyId Int
  role      CompanyRole @default(EMPLOYEE)

  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services  EmployeeService[]
  schedules Schedule[]

  @@unique([userId, companyId])
  @@map("company_users")
}

model Service {
  id              Int     @id @default(autoincrement())
  companyId       Int
  name            String  @db.VarChar(150)
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees EmployeeService[]

  @@map("services")
}

model EmployeeService {
  companyUserId Int
  serviceId     Int

  companyUser  CompanyUser   @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@id([companyUserId, serviceId])
  @@map("employee_service")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Schedule {
  id            Int @id @default(autoincrement())
  companyUserId Int
  dayOfWeek     Int
  startMinute   Int
  endMinute     Int

  companyUser CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  @@index([companyUserId, dayOfWeek])
  @@map("schedules")
}

model Appointment {
  id                       Int               @id @default(autoincrement())
  companyUserId            Int
  serviceId                Int
  customerUserId           Int
  startAt                  DateTime          @db.Timestamptz(3)
  endAt                    DateTime          @db.Timestamptz(3)
  status                   AppointmentStatus @default(PENDING)
  companyNameAtBooking     String            @db.VarChar(150)
  employeeNameAtBooking    String?           @db.VarChar(150)
  serviceNameAtBooking     String            @db.VarChar(150)
  customerNameAtBooking    String            @db.VarChar(150)
  customerEmailAtBooking   String            @db.VarChar(255)
  priceAtBooking           Decimal           @db.Decimal(10, 2)
  durationMinutesAtBooking Int
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)

  employeeService EmployeeService @relation(fields: [companyUserId, serviceId], references: [companyUserId, serviceId], onDelete: Restrict)
  customer        User            @relation(fields: [customerUserId], references: [id], onDelete: Restrict)

  @@index([companyUserId, startAt])
  @@index([customerUserId, startAt])
  @@index([status, startAt])
  @@map("appointments")
}
